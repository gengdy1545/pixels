# Fixed layout inside the formal bundle. Resolved by install scripts at runtime.

resolve_bundle_root()
{
    local script="$1"
    local candidate
    candidate="$(cd "$(dirname "${script}")/.." && pwd)"
    if [[ -f "${candidate}/formal-defaults.env" ]]
    then
        printf '%s\n' "${candidate}"
        return 0
    fi
    candidate="$(cd "$(dirname "${script}")/../.." && pwd)"
    if [[ -f "${candidate}/formal-defaults.env" ]]
    then
        printf '%s\n' "${candidate}"
        return 0
    fi
    return 1
}
