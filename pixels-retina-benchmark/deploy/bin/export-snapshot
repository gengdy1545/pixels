#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ $# -eq 0 || "${1:-}" == "--help" ]]; then
  cat <<'USAGE'
Export a Retina benchmark snapshot from an existing Pixels deployment.

Before copying Index state, stop CDC/update/load/compaction and both GC paths,
drain all writes, then wait for the running Transaction Service to complete at
least one 10-second watermark checkpoint. Gracefully stop the Retina daemon
that owns RocksDB/SQLite. Source etcd, Metadata Service, and Pixels storage must
remain reachable by the exporter.

Required options:
  --snapshot-output DIR
  --snapshot-schema SCHEMA
  --snapshot-tables TABLE[,TABLE...]

Snapshot v2 contains snapshot.json and, optionally, state/index with complete
RocksDB and SQLite copies. Visibility always uses a clean baseline built from
manifest footer recordNum values; no Visibility state is exported.

Node/physical state options:
  --snapshot-source-host HOST          (defaults to exporter hostname)
  --snapshot-retina-vnodes ID[,ID...]   (provenance only)
  --snapshot-index-buckets ID[,ID...]   (normally auto-discovered from CF names)
  --snapshot-source-quiesced true
  --snapshot-copy-index-state true
  --snapshot-rocksdb-dir DIR       (defaults to pixels.properties)
  --snapshot-sqlite-dir DIR        (defaults to pixels.properties)

PIXELS_HOME must already point at the source Pixels deployment. Configuration
follows ConfigFactory priority: PIXELS_CONFIG first, otherwise
PIXELS_HOME/etc/pixels.properties. The runtime JAR and log configuration always
come from this script's own ROOT_DIR.

Only --snapshot-copy-index-state true reads source etcd. It derives
snapshotTimestamp as trans_high_watermark - 1; no timestamp is supplied by the
operator. The output directory must be new. This script cannot drain a live
PixelsWriteBuffer; do that explicitly before stopping Retina.

Example from the unpacked benchmark runtime after PIXELS_HOME is set:
  bin/export-snapshot \
      --snapshot-output /data/snapshots/node-a \
      --snapshot-schema tpch \
      --snapshot-tables customer,lineitem,orders \
      --snapshot-source-host node-a \
      --snapshot-retina-vnodes 0,1,2,3 \
      --snapshot-source-quiesced true \
      --snapshot-copy-index-state true

After copying the result to the benchmark machine, run:
  bin/run-benchmark snapshot-validate --snapshot-dir DIR

See SNAPSHOT.md for the full consistency protocol.
USAGE
  exit 0
fi

if [[ -z "${PIXELS_HOME:-}" ]]; then
  echo "error: PIXELS_HOME is not set; point it at the source Pixels deployment before exporting" >&2
  exit 2
fi

exec "${ROOT_DIR}/bin/run-benchmark" snapshot-export "$@"
