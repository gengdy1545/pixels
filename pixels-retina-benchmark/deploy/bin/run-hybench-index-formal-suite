#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="${RETINA_BENCHMARK_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
umask 077

SNAPSHOT_ROOT=""
RESULTS_ROOT="${RESULTS_ROOT:-${ROOT_DIR}/results}"
WORK_ROOT="${INDEX_WORK_ROOT:-/var/tmp/pixels-retina-benchmark/hybench-index}"
SOURCE_CONFIG="${PIXELS_CONFIG:-${ROOT_DIR}/etc/pixels.properties}"
JAVA_OPTS_VALUE="${INDEX_JAVA_OPTS:--Xms40g -Xmx40g}"
THREADS=16
BATCH_SIZE=4
WARMUP_SECONDS=30
WARMUP_OPERATIONS=100000
DURATION_SECONDS=60
DATA_SIZE=10000000
MAIN_INDEX_STATE="warm-cache"
SMOKE=false
DRY_RUN=false
KEEP_WORK_DIRS=false
ONLY_SCALE=""

TABLES=(customer company savingAccount checkingAccount transfer checking loanApps loanTrans)

usage()
{
    cat <<'EOF'
Usage: bin/run-hybench-index-formal-suite --snapshot-root DIR [options]

Runs Put, Update, and Delete on all eight HyBench primary-index tables for
sf1, sf10, and sf100 packages. Each package must be a directory containing
snapshot.json and state/index/{rocksdb,sqlite}. No secondary-index test is
included because the HyBench Index-only profile contains primary indexes only.

Options:
  --snapshot-root DIR             Parent containing sf1/, sf10/, sf100/
  --scale NAME                   Run only one scale
  --results-dir DIR              Results root (default: runtime/results)
  --work-dir-root DIR            Disposable Index work root (default: /var/tmp/...)
  --config FILE                  pixels.properties (default: runtime/etc)
  --java-opts TEXT               Benchmark JVM options (default: -Xms40g -Xmx40g)
  --threads N                    Worker threads (default: 16)
  --batch-size N                 Entries per Index batch (default: 4)
  --warmup-seconds N             Warmup time limit (default: 30)
  --warmup-operations N          Warmup operation limit (default: 100000)
  --duration-seconds N           Measurement time limit (default: 60)
  --data-size N                  Measurement operation limit (default: 10000000)
  --main-index-state STATE       Update/Delete MainIndex state (default: warm-cache)
  --keep-work-dirs               Preserve successful work copies
  --smoke                        Use tiny functional-test parameters
  --dry-run                      Print configuration without running
  -h, --help                     Show this help
EOF
}

log()
{
    printf '[hybench-index-formal] %s\n' "$*"
}

die()
{
    printf '[hybench-index-formal] ERROR: %s\n' "$*" >&2
    exit 1
}

require_value()
{
    local option="$1"
    local value="${2:-}"
    [[ -n "${value}" ]] || die "${option} requires a value"
}

while [[ $# -gt 0 ]]
do
    case "$1" in
        --snapshot-root) require_value "$1" "${2:-}"; SNAPSHOT_ROOT="$2"; shift 2 ;;
        --scale) require_value "$1" "${2:-}"; ONLY_SCALE="$2"; shift 2 ;;
        --results-dir) require_value "$1" "${2:-}"; RESULTS_ROOT="$2"; shift 2 ;;
        --work-dir-root) require_value "$1" "${2:-}"; WORK_ROOT="$2"; shift 2 ;;
        --config) require_value "$1" "${2:-}"; SOURCE_CONFIG="$2"; shift 2 ;;
        --java-opts) require_value "$1" "${2:-}"; JAVA_OPTS_VALUE="$2"; shift 2 ;;
        --threads) require_value "$1" "${2:-}"; THREADS="$2"; shift 2 ;;
        --batch-size) require_value "$1" "${2:-}"; BATCH_SIZE="$2"; shift 2 ;;
        --warmup-seconds) require_value "$1" "${2:-}"; WARMUP_SECONDS="$2"; shift 2 ;;
        --warmup-operations) require_value "$1" "${2:-}"; WARMUP_OPERATIONS="$2"; shift 2 ;;
        --duration-seconds) require_value "$1" "${2:-}"; DURATION_SECONDS="$2"; shift 2 ;;
        --data-size) require_value "$1" "${2:-}"; DATA_SIZE="$2"; shift 2 ;;
        --main-index-state) require_value "$1" "${2:-}"; MAIN_INDEX_STATE="$2"; shift 2 ;;
        --keep-work-dirs) KEEP_WORK_DIRS=true; shift ;;
        --smoke) SMOKE=true; shift ;;
        --dry-run) DRY_RUN=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown option: $1" ;;
    esac
done

[[ -n "${SNAPSHOT_ROOT}" ]] || die "--snapshot-root is required"
[[ -d "${SNAPSHOT_ROOT}" ]] || die "snapshot root not found: ${SNAPSHOT_ROOT}"
[[ -x "${ROOT_DIR}/bin/run-index-suite" ]] || die "run-index-suite not found under ${ROOT_DIR}/bin"
[[ -f "${SOURCE_CONFIG}" ]] || die "pixels.properties not found: ${SOURCE_CONFIG}"

if [[ -n "${ONLY_SCALE}" ]]
then
    case "${ONLY_SCALE}" in
        sf1|sf10|sf100) SCALES=("${ONLY_SCALE}") ;;
        *) die "scale must be sf1, sf10, or sf100: ${ONLY_SCALE}" ;;
    esac
else
    SCALES=(sf1 sf10 sf100)
fi

RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
FORMAL_RESULTS_ROOT="${RESULTS_ROOT%/}/hybench-index-formal-${RUN_ID}"
FORMAL_WORK_ROOT="${WORK_ROOT%/}/hybench-index-formal-${RUN_ID}"

if [[ "${DRY_RUN}" == "true" ]]
then
    log "dry run"
    printf 'snapshot_root=%s\nresults_root=%s\nwork_root=%s\nconfig=%s\n' \
        "${SNAPSHOT_ROOT}" "${FORMAL_RESULTS_ROOT}" "${FORMAL_WORK_ROOT}" "${SOURCE_CONFIG}"
    printf 'scales=%s\ntables=%s\n' "${SCALES[*]}" "${TABLES[*]}"
    printf 'threads=%s batch_size=%s warmup_seconds=%s warmup_operations=%s\n' \
        "${THREADS}" "${BATCH_SIZE}" "${WARMUP_SECONDS}" "${WARMUP_OPERATIONS}"
    printf 'duration_seconds=%s data_size=%s main_index_state=%s java_opts=%s\n' \
        "${DURATION_SECONDS}" "${DATA_SIZE}" "${MAIN_INDEX_STATE}" "${JAVA_OPTS_VALUE}"
    exit 0
fi

mkdir -p "${FORMAL_RESULTS_ROOT}"
{
    printf 'snapshot_root=%q\n' "${SNAPSHOT_ROOT}"
    printf 'results_root=%q\n' "${FORMAL_RESULTS_ROOT}"
    printf 'work_root=%q\n' "${FORMAL_WORK_ROOT}"
    printf 'config=%q\n' "${SOURCE_CONFIG}"
    printf 'scales=%q\n' "${SCALES[*]}"
    printf 'tables=%q\n' "${TABLES[*]}"
    printf 'threads=%q\n' "${THREADS}"
    printf 'batch_size=%q\n' "${BATCH_SIZE}"
    printf 'warmup_seconds=%q\n' "${WARMUP_SECONDS}"
    printf 'warmup_operations=%q\n' "${WARMUP_OPERATIONS}"
    printf 'duration_seconds=%q\n' "${DURATION_SECONDS}"
    printf 'data_size=%q\n' "${DATA_SIZE}"
    printf 'main_index_state=%q\n' "${MAIN_INDEX_STATE}"
    printf 'java_opts=%q\n' "${JAVA_OPTS_VALUE}"
    printf 'keep_work_dirs=%q\n' "${KEEP_WORK_DIRS}"
} > "${FORMAL_RESULTS_ROOT}/parameters.env"

suite_args=(
    --results-dir "${FORMAL_RESULTS_ROOT}"
    --work-dir-root "${FORMAL_WORK_ROOT}"
    --config "${SOURCE_CONFIG}"
    --java-opts "${JAVA_OPTS_VALUE}"
    --threads "${THREADS}"
    --batch-size "${BATCH_SIZE}"
    --warmup-seconds "${WARMUP_SECONDS}"
    --warmup-operations "${WARMUP_OPERATIONS}"
    --duration-seconds "${DURATION_SECONDS}"
    --data-size "${DATA_SIZE}"
    --main-index-state "${MAIN_INDEX_STATE}"
)
if [[ "${KEEP_WORK_DIRS}" == "true" ]]; then suite_args+=(--keep-work-dirs); fi
if [[ "${SMOKE}" == "true" ]]; then suite_args+=(--smoke); fi

for scale in "${SCALES[@]}"
do
    snapshot_dir="${SNAPSHOT_ROOT%/}/${scale}"
    [[ -f "${snapshot_dir}/snapshot.json" ]] || die "missing ${scale} Snapshot: ${snapshot_dir}"
    for table in "${TABLES[@]}"
    do
        log "===== ${scale} / ${table}: Put, Update, Delete ====="
        set +e
        PIXELS_CONFIG="${SOURCE_CONFIG}" \
            "${ROOT_DIR}/bin/run-index-suite" \
            --snapshot-dir "${snapshot_dir}" \
            --snapshot-table "${table}" \
            "${suite_args[@]}" \
            2>&1 | tee "${FORMAL_RESULTS_ROOT}/${scale}-${table}.log"
        suite_status=${PIPESTATUS[0]}
        set -e
        [[ "${suite_status}" -eq 0 ]] ||
            die "${scale}/${table} Index suite failed; see ${FORMAL_RESULTS_ROOT}/${scale}-${table}.log"
    done
done

{
    printf 'status=completed\n'
    printf 'results_root=%s\n' "${FORMAL_RESULTS_ROOT}"
    printf 'scales=%s\n' "${SCALES[*]}"
    printf 'tables=%s\n' "${TABLES[*]}"
    printf 'duration_seconds=%s\n' "${DURATION_SECONDS}"
    printf 'main_index_state=%s\n' "${MAIN_INDEX_STATE}"
} > "${FORMAL_RESULTS_ROOT}/summary.txt"
cat "${FORMAL_RESULTS_ROOT}/summary.txt"
log "HyBench Index formal suite completed successfully"
