# Formal Retina benchmark defaults. Sourced by bootstrap.sh and
# run-retina-formal-suite. Override with environment variables when needed.

SNAPSHOT_S3_URI="${SNAPSHOT_S3_URI:-s3://home-dongyang/data/node-a}"
SNAPSHOT_DIR="${SNAPSHOT_DIR:-/data/retina-benchmark/snapshot/node-a}"

S3_ROOT="${S3_ROOT:-s3://home-dongyang/retina-benchmark}"
RESULTS_ROOT="${RESULTS_ROOT:-/data/retina-benchmark/results}"
RESULTS_S3_ROOT="${RESULTS_S3_ROOT:-s3://home-dongyang/data/retina-result}"

WORK_ROOT="${WORK_ROOT:-/data/retina-benchmark/work}"
STATE_ROOT="${STATE_ROOT:-/var/tmp/pixels-retina-benchmark}"

FORMAL_JAVA_OPTS="${FORMAL_JAVA_OPTS:--Xms40g -Xmx40g}"

MYSQL_USER="${MYSQL_USER:-pixels}"
MYSQL_PASSWORD="${MYSQL_PASSWORD:-password}"
MYSQL_DATABASE="${MYSQL_DATABASE:-pixels_metadata}"
MYSQL_HOST="${MYSQL_HOST:-localhost}"
MYSQL_PORT="${MYSQL_PORT:-3306}"
